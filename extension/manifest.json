{
  "manifest_version": 3,
  "name": "Kino Recorder",
  "version": "0.4.1",
  "description": "Record your screen and camera. Get a share link with a transcript and an AI summary.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Kino (Alt+Shift+K)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "desktopCapture",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open Kino"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume the recording"
    },
    "stop-recording": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop the recording and share"
    }
  },
  "minimum_chrome_version": "120",
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js",
        "bubble.html",
        "bubble.js",
        "style.css",
        "shared.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
